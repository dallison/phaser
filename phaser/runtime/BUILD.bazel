load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load(
    "//phaser:copts.bzl",
    "PHASER_COPTS",
    "PHASER_PROTOBUF_GENERATED_COPTS",
)

package(default_visibility = ["//visibility:public"])

# Serializing a message writes without checking for room, trusting the
# caller to have made enough (see kTrustSerializedSize in wireformat.h).
bool_flag(
    name = "trust_serialized_size",
    build_setting_default = False,
)

config_setting(
    name = "trusts_serialized_size",
    flag_values = {":trust_serialized_size": "True"},
)

cc_library(
    name = "payload_buffer",
    srcs = ["payload_buffer.cc"],
    hdrs = ["payload_buffer.h"],
    copts = PHASER_COPTS,
    deps = [
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/types:span",
    ],
)

cc_test(
    name = "payload_buffer_test",
    srcs = ["payload_buffer_test.cc"],
    copts = PHASER_COPTS,
    data = ["//phaser:valgrind.supp"],
    deps = [
        ":payload_buffer",
        "@com_google_googletest//:gtest",
        "@cpp_toolbelt//toolbelt",
    ],
)

cc_library(
    name = "phaser_runtime",
    srcs = [
        "arrow.cc",
        "md5.cc",
        "message.cc",
        "phaser_bank.cc",
    ],
    copts = PHASER_COPTS,
    defines = select({
        ":trusts_serialized_size": ["PHASER_TRUST_SERIALIZED_SIZE"],
        "//conditions:default": [],
    }),
    hdrs = [
        "active_message.h",
        "any.h",
        "arrow.h",
        "arrow_abi.h",
        "arrays.h",
        "fields.h",
        "iterators.h",
        "md5.h",
        "message.h",
        "runtime.h",
        "ros_direct.h",
        "ros_wireformat.h",
        "union.h",
        "vectors.h",
        "wireformat.h",
        "phaser_bank.h",
        "ros.h",
    ],
    deps = [
        ":payload_buffer",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/base:no_destructor",
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/functional:function_ref",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:str_format",
        "@com_google_absl//absl/types:span",
        "@cpp_toolbelt//toolbelt",
    ],
)

cc_library(
    name = "phaser_bank_protobuf",
    srcs = ["phaser_bank_protobuf.cc"],
    hdrs = ["phaser_bank_protobuf.h"],
    copts = PHASER_COPTS,
    deps = [
        ":phaser_runtime",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:str_format",
        "@com_google_protobuf//:protobuf",
    ],
)

cc_test(
    name = "md5_test",
    srcs = ["md5_test.cc"],
    copts = PHASER_COPTS,
    data = ["//phaser:valgrind.supp"],
    deps = [
        ":phaser_runtime",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_test(
    name = "message_test",
    srcs = [
        "message_test.cc",
    ],
    copts = PHASER_COPTS + PHASER_PROTOBUF_GENERATED_COPTS,
    data = ["//phaser:valgrind.supp"],
    deps = [
        ":phaser_runtime",
        "//phaser/testdata:test_message_cc_proto",
        "@com_google_absl//absl/strings:str_format",
        "@com_google_googletest//:gtest",
        "@cpp_toolbelt//toolbelt",
    ],
)

cc_test(
    name = "wireformat_test",
    srcs = [
        "wireformat_test.cc",
    ],
    copts = PHASER_COPTS,
    data = ["//phaser:valgrind.supp"],
    deps = [
        ":phaser_runtime",
        "@com_google_absl//absl/strings:str_format",
        "@com_google_googletest//:gtest",
        "@cpp_toolbelt//toolbelt",
    ],
)

cc_test(
    name = "ros_wireformat_test",
    srcs = ["ros_wireformat_test.cc"],
    copts = PHASER_COPTS,
    data = ["//phaser:valgrind.supp"],
    deps = [
        ":phaser_runtime",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_test(
    name = "arrow_test",
    srcs = ["arrow_test.cc"],
    copts = PHASER_COPTS,
    data = ["//phaser:valgrind.supp"],
    deps = [
        ":phaser_runtime",
        "@com_google_googletest//:gtest_main",
    ],
)
