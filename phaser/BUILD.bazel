cc_test(
    name = "ros_wire_conversion_test",
    srcs = ["ros_wire_conversion_test.cc"],
    copts = PHASER_COPTS,
    data = ["valgrind.supp"],
    deps = [
        "//phaser/runtime:phaser_runtime",
