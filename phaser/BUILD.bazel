cc_test(
    name = "receive_allocation_test",
    srcs = ["receive_allocation_test.cc"],
    copts = PHASER_COPTS,
    data = ["valgrind.supp"],
    deps = [
        "//phaser/runtime:phaser_runtime",
        "//phaser/testdata:ros_compile_phaser",
        "//phaser/testdata:ros_intrinsics_phaser",
        "//phaser/testdata:test_message_phaser",
        "@com_google_googletest//:gtest_main",
    ],
