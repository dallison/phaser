    copts = PHASER_COPTS,
    data = ["valgrind.supp"],
    deps = [
        "//phaser/runtime:phaser_runtime",
        "//phaser/testdata:ros_intrinsics_phaser",
        "//phaser/testdata:ros_intrinsics_protobuf_phaser",
