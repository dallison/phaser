cc_test(
    name = "all_types_test",
    srcs = ["all_types_test.cc"],
    copts = PHASER_COPTS,
    data = ["valgrind.supp"],
    deps = [
        ":test_helpers",
        "//phaser/runtime:phaser_runtime",
        "//phaser/testdata:coverage_cc_proto",
        "//phaser/testdata:coverage_phaser",
        "@com_google_absl//absl/status",
        "@com_google_googletest//:gtest_main",
    ],
