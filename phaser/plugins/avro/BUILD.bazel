load("@pybind11_bazel//:build_defs.bzl", "pybind_library")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//phaser:copts.bzl", "PHASER_COPTS", "PHASER_PROTOC_COPTS")
load("//phaser/plugins:defs.bzl", "PHASER_PLUGIN_COMMON_DEPS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "codegen",
    srcs = ["gen/codegen.cc"],
    alwayslink = True,
    copts = PHASER_PROTOC_COPTS,
    deps = ["//phaser/compiler:message_generator"],
)

pybind_library(
    name = "pybind",
    srcs = ["runtime/pybind.cc"],
    alwayslink = True,
    copts = PHASER_COPTS,
    deps = [
        ":runtime",
        "//phaser/runtime:plugin_pybind",
    ],
)

cc_library(
    name = "runtime",
    srcs = ["runtime/avro.cc"],
    hdrs = ["runtime/avro.h"],
    copts = PHASER_COPTS,
    include_prefix = "phaser/plugins/avro",
    strip_include_prefix = "runtime",
    deps = [
        "//phaser/plugins/arrow:runtime",
        "//phaser/runtime:phaser_runtime",
    ] + PHASER_PLUGIN_COMMON_DEPS,
)

cc_library(
    name = "conversion",
    srcs = ["runtime/avro_conversion.cc"],
    alwayslink = True,
    copts = PHASER_COPTS,
    deps = [
        ":runtime",
        "//phaser/plugins/common:conversion_plugin",
    ],
)
