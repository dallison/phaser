# Explicit platforms for cross-compilation and macOS Rust crate resolution.
package(default_visibility = ["//visibility:public"])

platform(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
)

platform(
    name = "darwin_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:osx",
    ],
)

# Cross-compilation target: 32-bit ARM Linux, hard float (armhf / ARMv7).
# Select with --config=linux_arm32.
platform(
    name = "linux_arm32",
    constraint_values = [
        "@platforms//cpu:armv7",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "linux_arm32_setting",
    values = {"platforms": "//platform:linux_arm32"},
)
